      "request": "launch",
      "type": "dart",
      "program": "lib/main_uat.dart",
      "toolArgs": [
        "--flavor",
        "uat"
      ]
    },
    {
      "name": "BS Units — Android Production (debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_prod.dart",
      "toolArgs": [
        "--flavor",
        "prod"
      ]
    },
    {
      "name": "BS Units — Android UAT (profile)",
      "request": "launch",
      "type": "dart",
